<?xml version="1.0" encoding="ISO-8859-1"?>

<sample_binning>

  <!-- Single Mondrian binning scheme for reco quantities -->
  <reco_optimized>
    binning/reco/valor_juno_binning_2D.xml
  </reco_optimized>

  <!-- Single edge-to-edge binning scheme for reco quantities -->
  <reco_simple>
    binning/reco/valor_juno_binning_2D.xml
  </reco_simple>

  <!-- Fine true-space binning for event-rate / oscillation handling.
       Reco fit binning remains coarse and independent. -->
  <true_simple>
    <!-- Applies to all modes unless a mode binning scheme
         is specified explicitly below -->
    <default>
      binning/true/juno_2D_binning_fine_400x400.xml
    </default>

  </true_simple>

  <xsec_reco>
    binning/reco/valor_juno_binning_2D.xml
  </xsec_reco>

  <xsec_true>
    <!-- Applies to all modes unless a mode binning scheme
         is specified explicitly below -->
    <default>
      binning/true/juno_2D_binning_fine_400x400.xml
    </default>
  </xsec_true>

</sample_binning>