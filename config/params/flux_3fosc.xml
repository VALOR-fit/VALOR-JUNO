<?xml version="1.0"?>
<param_list name="juno_flux_parameters">
  <!--
    EXPLANATION: This file specifies values for physics parameters which are read when
    populating the fit parameter list. Note that the values and ranges specified here
    do NOT specify the priors, as priors are specified in config files of a different
    format (see config/priors/).
    For a explanation of what each node is, see Parameter.h
  -->

  <!--
     NOTE: The values specified for any physics parameters in this file must correspond to these schemes,
     which must also match the schemes set in Opt::Instance()

     This is used in the definition of the mass hierarchy so no modifications are needed in the sterile case
  -->
  <schemes>
    <mixing> sinsqtheta </mixing>
    <phase>  delta      </phase>
    <Dmsq>   abs23      </Dmsq>
  </schemes>

  <param>
    <name>
      <simple> dm12sq </simple>
    </name>
    <type> special </type>
    <limits> 0.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> 6.63e-5, 8.43e-5 </range>
    <step_mode> value </step_mode>
    <step> 2e-07 </step>
    <init> 6.99e-5 </init>
  </param>

  <param>
    <name>
      <simple> dm23sq </simple>
    </name>
    <type> special </type>
    <limits> 0.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> 2.0e-3, 3.0e-3 </range>
    <step_mode> value </step_mode>
    <step> 2e-6 </step>
    <init> 2.4e-3 </init>
  </param>

  <param>
    <name>
      <simple> mixing12 </simple>
    </name>
    <type> special </type>
    <limits> 0.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> 0.247, 0.372 </range>
    <step_mode> value </step_mode>
    <step> 0.002 </step>
    <init> 0.29 </init>
  </param>

  <param>
    <name>
      <simple> mixing13 </simple>
    </name>
    <type> special </type>
    <limits> 0.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> 0.0184, 0.0254 </range>
    <step_mode> value </step_mode>
    <step> 0.0002 </step>
    <init> 0.02 </init>
  </param>

  <param>
    <name>
      <simple> mixing23 </simple>
    </name>
    <type> special </type>
    <limits> 0.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> 0.3, 0.7 </range>
    <step_mode> value </step_mode>
    <step> 0.002 </step>
    <init> 0.5 </init>
  </param>

  <param>
    <name>
      <simple> cpv </simple>
    </name>
    <type> special </type>
    <limits> -10.0, 10.0 </limits>
    <range_mode> value </range_mode>
    <range> 0.0, 6.29 </range>
    <step_mode> value </step_mode>
    <step> 0.02 </step>
    <init> 1.853 </init>
  </param>

  <param>
    <name>
      <simple> juno_eres_e </simple>
    </name>

    <type> normalisation </type>
    <nuisance> true </nuisance>
    <fixed> true </fixed>

    <categories>
      <category> detector </category>
      <category> det </category>
      <category> JUNO </category>
      <category> FD </category>
    </categories>

    <limits> -1.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> -1.0, 1.0 </range>
    <step_mode> value </step_mode>
    <step> 0.1 </step>
    <init> 0.0 </init>
  </param>

  <param>
    <name>
      <simple> juno_eres_mu </simple>
    </name>
    <type> normalisation </type>
    <nuisance> true </nuisance>
    <fixed> true </fixed>

    <categories>
      <category> det </category>
      <category> detector </category>
      <category> JUNO </category>
      <category> FD </category>
    </categories>

    <limits> -1.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> -1.0, 1.0 </range>
    <step_mode> value </step_mode>
    <step> 0.1 </step>
    <init> 0.0 </init>
  </param>

  <param>
    <name>
      <simple> juno_ebias_e </simple>
    </name>
    <type> normalisation </type>
    <nuisance> true </nuisance>
    <fixed> true </fixed>

    <categories>
      <category> det </category>
      <category> detector </category>
      <category> JUNO </category>
      <category> FD </category>
    </categories>

    <limits> -1.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> -1.0, 1.0 </range>
    <step_mode> value </step_mode>
    <step> 0.1 </step>
    <init> 0.0 </init>
  </param>

  <param>
    <name>
      <simple> juno_ebias_mu </simple>
    </name>
    <type> normalisation </type>
    <nuisance> true </nuisance>
    <fixed> true </fixed>

    <categories>
      <category> det </category>
      <category> detector </category>
      <category> JUNO </category>
      <category> FD </category>
    </categories>

    <limits> -1.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> -1.0, 1.0 </range>
    <step_mode> value </step_mode>
    <step> 0.1 </step>
    <init> 0.0 </init>
  </param>

  <param>
    <name>
      <simple> juno_ares </simple>
    </name>
    <type> normalisation </type>
    <nuisance> true </nuisance>
    <fixed> true </fixed>

    <categories>
      <category> det </category>
      <category> detector </category>
      <category> JUNO </category>
      <category> FD </category>
    </categories>

    <limits> -1.0, 1.0 </limits>
    <range_mode> value </range_mode>
    <range> -1.0, 1.0 </range>
    <step_mode> value </step_mode>
    <step> 0.1 </step>
    <init> 0.0 </init>
  </param>

</param_list>

