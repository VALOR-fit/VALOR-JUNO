# SBN CAF stuff
#SBNCAF_INC = -I$(SBNCODE_DIR)/

#-------------------------------------------------------------------
#                        GENIE
#-------------------------------------------------------------------

# Add GENIE includes and libaries for apps that depend both on GENIE and VALOR
# GENIE needs to be enabled to compile those apps
#

#ifeq(, $(shell which genie-config))
ifdef GENIE
 GLIBRARIES = $(shell genie-config --libs)
 
 # Hack while GENIE_REWEIGHT independent package is not good at reporting its own libraries
 ifdef GENIE_REWEIGHT
   GLIBRARIES += -L$(GENIE_REWEIGHT)/lib -lGRwFwk -lGRwClc -lGRwIO
 endif
 
 GINCLUDES  = $(GENIE_INCLUDES)
 GINCLUDES  := $(INCLUDES)
 GLIBRARIES := $(LIBRARIES) $(GLIBRARIES)
 ifeq ("false",$(is_cln))
  VALOR_GLIBRARIES := $(shell valor_fmwk-config --glibs)
 endif
endif


#-------------------------------------------------------------------
#                      SUMMING-UP
#-------------------------------------------------------------------

# includes and libraries needed to compile programs. 

VALOR_INCLUDES := $(VALOR_EXPT_INCLUDES) \
                  $(VALOR_FMWK_INCLUDES)

INCLUDES  := $(VALOR_EXPT_INCLUDES) \
             $(VALOR_FMWK_INCLUDES) \
             $(LOG_INCLUDES) \
             $(ROOT_INCLUDES) \
             $(GSL_INCLUDES) \
             $(LINUX_SYS_INCLUDES)

LIBRARIES := $(SYSLIBS) \
             $(VALOR_EXPT_LIBRARIES) \
             $(VALOR_FMWK_LIBRARIES) \
             $(LOG_LIBRARIES) \
             $(ROOT_LIBRARIES) \
             $(GSL_LIBRARIES) \
             $(GPROF_LIBRARIES) \
             $(OPT_WITH_MISC_LIBS)
             
# Default compiler and preprocessor flags

CXXFLAGS := $(ENV_CXXFLAGS) $(CXXFLAGS)
CPPFLAGS  = $(INCLUDES)
CFLAGS    = $(OPT_WITH_CXX_DEBUG_FLAG)

