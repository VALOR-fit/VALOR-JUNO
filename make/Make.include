# Costas Andreopoulos (Rutherford Lab.) <constantinos.andreopoulos \at cern.ch>
#

VALOR_SDK_TOPDIR  = $(VALOR_FMWK)
VALOR_EXPT_TOPDIR = $(VALOR_EXPT)

# Include framework includes 
include $(VALOR_FMWK)/make/Make.include

include $(VALOR_EXPT_TOPDIR)/make/Make.config

ifndef OPT_WITH_CXX_USERDEF_FLAGS
 OPT_WITH_CXX_USERDEF_FLAGS=
endif

# Check if this is a "clean" command, we can skip some stuff
ifeq (clean,$(findstring clean,$(MAKECMDGOALS)))
  is_cln="true"
else
  is_cln="false"
endif

#-------------------------------------------------------------------
#                      VALOR FRAMEWORK CODE
#-------------------------------------------------------------------

# VALOR framework release info
#
VALOR_FMWK_VERSION  = $(shell awk '{print $0}' $(OPT_WITH_VALOR_FRAMEWORK)/VERSION)

# VALOR framework include path
#
VALOR_FMWK_INCLUDES  := -I$(OPT_WITH_VALOR_FRAMEWORK)/src/

# VALOR framework libraries
#
ifeq ("false",$(is_cln))
  VALOR_FMWK_LIBRARIES = $(shell valor_fmwk-config --libs)
endif

#-------------------------------------------------------------------
#                        VALOR EXPT CODE
#-------------------------------------------------------------------

# VALOR expt-specific code release info
#
VALOR_EXPT_VERSION  = $(shell awk '{print $0}' $(VALOR_EXPT_TOPDIR)/VERSION)

# VALOR expt-specific include path
#
VALOR_EXPT_INCLUDES := -I$(VALOR_EXPT_TOPDIR)/src/

# VALOR expt-specific libraries
#
ifeq ("false",$(is_cln))
  VALOR_EXPT_LIBRARIES = $(shell valor_expt-config --libs)
endif


